{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisionAgentOutput",
  "type": "object",
  "required": ["image_count", "observations", "uncertainty_notes"],
  "properties": {
    "image_count": { "type": "integer", "minimum": 0 },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "confidence", "note"],
        "properties": {
          "label": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "uncertainty_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
